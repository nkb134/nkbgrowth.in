---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  icon: ImageMetadata;
  flip?: boolean;
  product: {
    name: string;
    role: string;
    tagline: string;
    description: string;
    site: string;
    whatsapp: string;
    steps: string[];
    features: { lead: string; text: string }[];
    stack: string[];
  };
}

const { icon, product, flip = false } = Astro.props;
const host = new URL(product.site).hostname;
---

<article class:list={['product', flip && 'product--flip']}>
  <div class="product__text" data-reveal>
    <header class="product__head">
      <Image src={icon} alt="" width={128} height={128} class="product__icon" />
      <div>
        <h3>{product.name}</h3>
        <p class="label">{product.role}</p>
      </div>
    </header>

    <p class="product__tagline">{product.tagline}</p>
    <p class="product__desc">{product.description}</p>

    <div class="product__links">
      <a class="btn btn--solid btn--small" href={product.whatsapp} rel="noopener">
        <Icon name="whatsapp" />Try it on WhatsApp
      </a>
      <a class="btn btn--small" href={product.site} rel="noopener">
        <Icon name="globe" />{host}
      </a>
    </div>

    <div class="product__block">
      <h4 class="label">How a sale happens</h4>
      <ol class="steps">
        {product.steps.map((s) => <li>{s}</li>)}
      </ol>
    </div>

    <div class="product__block">
      <h4 class="label">What I built</h4>
      <ul class="features">
        {
          product.features.map((f) => (
            <li>
              <strong>{f.lead}.</strong> {f.text}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="product__block">
      <h4 class="label">Stack</h4>
      <ul class="chips">
        {product.stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>

  <div class="product__demo" data-reveal>
    <slot name="demo" />
  </div>
</article>

<style>
  .product {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1.5px solid var(--ink);
  }

  .product__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .product__head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product__icon {
    width: 4rem;
    height: 4rem;
    border-radius: 22%;
    border: 1px solid var(--rule);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    font-stretch: 80%;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .product__tagline {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .product__desc {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .product__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .product__block {
    display: grid;
    gap: 0.7rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }

  h4 {
    margin: 0;
  }

  .steps {
    display: grid;
    gap: 0.5rem;
    counter-reset: step;
    max-width: var(--measure);
  }

  .steps li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.9;
  }

  .features {
    display: grid;
    gap: 0.6rem;
    max-width: var(--measure);
  }

  .features li {
    color: var(--ink-soft);
  }

  .features strong {
    color: var(--ink);
  }

  .product__demo {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    align-content: start;
  }

  @media (min-width: 60rem) {
    .product {
      grid-template-columns: minmax(0, 1fr) 24rem;
    }

    .product--flip {
      grid-template-columns: 24rem minmax(0, 1fr);
    }

    .product--flip .product__demo {
      order: -1;
    }
  }
</style>
