---
import { Image } from 'astro:assets';
import ChatDemo from './ChatDemo.astro';
import Phone from './Phone.astro';
import Product from './Product.astro';
import studioIcon from '../assets/icons/tara-studio.png';
import jyotishIcon from '../assets/icons/tara-jyotish.png';
import viralPoster from '../assets/tara/viral-poster.jpg';
import bookCover from '../assets/tara/book-cover.webp';
import bookPage from '../assets/tara/book-p05.webp';
import { jyotish, jyotishChat, studio, traction, ventures } from '../data/products';

const { rinnwealth } = ventures;
---

<section class="section wrap" id="products" aria-labelledby="products-title">
  <div class="section-head" data-reveal>
    <p class="label">My own products</p>
    <h2 id="products-title">Then I started building <span class="hi">the whole product</span></h2>
    <p>
      Two AI products that live in WhatsApp and take payment by UPI inside the chat. I built the onboarding,
      the generation pipeline, the payments and the acquisition funnel myself.
    </p>
  </div>

  <dl class="traction" data-reveal>
    {
      traction.map((t) => (
        <div>
          <dt>{t.label}</dt>
          <dd>{t.value}</dd>
        </div>
      ))
    }
  </dl>
  <p class="traction__note label">Both Tara products combined</p>

  <Product product={studio} icon={studioIcon}>
    <Fragment slot="demo">
      <figure class="video">
        <Phone name={studio.name} icon={studioIcon} status="Make me viral · 26 s">
          <video
            controls
            muted
            loop
            playsinline
            preload="metadata"
            poster={viralPoster.src}
            data-autoplay
            aria-label="Make me viral demo: a reel link and one selfie go to Tara, and the reel comes back with the sender in it"
          >
            <source src="/media/tara-make-me-viral.mp4" type="video/mp4" />
          </video>
          <button class="sound" type="button" data-sound aria-pressed="false">Turn sound on</button>
        </Phone>
        <figcaption>
          A reel link and one selfie went in. The second half is the reel that came back.
        </figcaption>
      </figure>

      <div class="outputs">
        <p class="label">What else it makes</p>
        <ul class="stickers">
          {
            studio.stickers.map((s) => (
              <li>
                <img src={`/media/sticker-${s}.webp`} alt={`Animated sticker: ${s}`} width="224" height="224" loading="lazy" />
              </li>
            ))
          }
        </ul>
        <ul class="pages">
          <li><Image src={bookCover} alt="Storybook cover: Sara’s Red Raincoat" width={280} /></li>
          <li><Image src={bookPage} alt="Storybook page with the child drawn into the scene" width={280} /></li>
        </ul>
      </div>
    </Fragment>
  </Product>

  <Product product={jyotish} icon={jyotishIcon} flip>
    <ChatDemo
      slot="demo"
      name="Tara"
      icon={jyotishIcon}
      messages={jyotishChat}
      caption="This is the live English onboarding script. Tara’s lines are the product’s real copy. Meera is made up."
    />
  </Product>

  <div class="ventures" id="ventures">
    <article class="venture" data-reveal>
      <div class="venture__head">
        <p class="label">{rinnwealth.role}</p>
        <h3>{rinnwealth.name}</h3>
        <p class="venture__line">{rinnwealth.line}</p>
      </div>
      <div class="venture__detail">
        {rinnwealth.body.map((b) => <p class="venture__body">{b}</p>)}
        <ul class="chips">
          {rinnwealth.stack.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .traction {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .traction div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--hi);
  }

  .traction dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    font-stretch: 76%;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .traction dt {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .traction__note {
    margin-top: 0.7rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .ventures {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    border-top: 1.5px solid var(--ink);
    scroll-margin-top: 4.5rem;
  }

  .venture {
    display: grid;
    gap: 0.8rem 3rem;
    padding: clamp(1.1rem, 2vw, 1.6rem);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .venture__head,
  .venture__detail {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .venture h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    font-stretch: 80%;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .venture__line {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }

  .venture__body {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .venture {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    }
  }

  .video {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  .video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--ink);
  }

  .sound {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.45em 0.8em;
    border: 0;
    border-radius: 999px;
    background: var(--hi);
    color: var(--ink);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }

  .video figcaption {
    max-width: 20rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--ink-soft);
    text-align: center;
  }

  .outputs {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 20rem);
  }

  .stickers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
  }

  .stickers img {
    width: 100%;
  }

  .pages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .pages img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
</style>
