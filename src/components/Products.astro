---
import { Image } from 'astro:assets';
import ChatDemo from './ChatDemo.astro';
import Phone from './Phone.astro';
import Product from './Product.astro';
import studioIcon from '../assets/icons/tara-studio.png';
import jyotishIcon from '../assets/icons/tara-jyotish.png';
import studioPoster from '../assets/tara/studio-poster.jpg';
import bookCover from '../assets/tara/book-cover.webp';
import bookPage from '../assets/tara/book-p05.webp';
import Icon from './Icon.astro';
import arenaShot from '../assets/shots/arena.jpg';
import { jyotish, jyotishChat, studio, traction, ventures } from '../data/products';

const { rinnwealth, arena } = ventures;
---

<section class="section wrap" id="products" aria-labelledby="products-title">
  <div class="section-head" data-reveal>
    <p class="label">My own products</p>
    <h2 id="products-title">Then I started building <span class="hi">the whole product</span></h2>
    <p>
      Two AI products that live in WhatsApp and take payment by UPI inside the chat. I built the onboarding,
      the generation pipeline, the payments and the acquisition funnel myself.
    </p>
  </div>

  <dl class="traction" data-reveal>
    {
      traction.map((t) => (
        <div>
          <dt>{t.label}</dt>
          <dd>{t.value}</dd>
        </div>
      ))
    }
  </dl>
  <p class="traction__note label">Both Tara products combined</p>

  <Product product={studio} icon={studioIcon}>
    <Fragment slot="demo">
      <figure class="video">
        <Phone name={studio.name} icon={studioIcon} status="product demo · 39 s">
          <video
            controls
            playsinline
            preload="none"
            poster={studioPoster.src}
            aria-label="Tara AI Studio product demo video"
          >
            <source src="/media/tara-studio-demo.mp4" type="video/mp4" />
          </video>
        </Phone>
        <figcaption>New users get this video as Tara’s first message. It has sound.</figcaption>
      </figure>

      <div class="outputs">
        <p class="label">What it makes</p>
        <ul class="stickers">
          {
            studio.stickers.map((s) => (
              <li>
                <img src={`/media/sticker-${s}.webp`} alt={`Animated sticker: ${s}`} width="224" height="224" loading="lazy" />
              </li>
            ))
          }
        </ul>
        <ul class="pages">
          <li><Image src={bookCover} alt="Storybook cover: Sara’s Red Raincoat" width={280} /></li>
          <li><Image src={bookPage} alt="Storybook page with the child drawn into the scene" width={280} /></li>
        </ul>
      </div>
    </Fragment>
  </Product>

  <Product product={jyotish} icon={jyotishIcon} flip>
    <ChatDemo
      slot="demo"
      name="Tara"
      icon={jyotishIcon}
      messages={jyotishChat}
      caption="This is the live English onboarding script. Tara’s lines are the product’s real copy. Meera is made up."
    />
  </Product>

  <div class="ventures" id="ventures">
    <article class="venture" data-reveal>
      <header>
        <h3>{rinnwealth.name}</h3>
        <p class="label">{rinnwealth.role}</p>
      </header>
      <p class="venture__line">{rinnwealth.line}</p>
      {rinnwealth.body.map((b) => <p class="venture__body">{b}</p>)}
      <ul class="chips">
        {rinnwealth.stack.map((s) => <li>{s}</li>)}
      </ul>
    </article>

    <article class="venture venture--media" data-reveal>
      <Image src={arenaShot} alt="Arena: a chess board mid-game with a move list and two clocks" width={640} loading="lazy" />
      <div>
        <header>
          <h3>{arena.name}</h3>
          <p class="label">{arena.role}</p>
        </header>
        <p class="venture__line">{arena.line}</p>
        {arena.body.map((b) => <p class="venture__body">{b}</p>)}
        <ul class="chips">
          {arena.stack.map((s) => <li>{s}</li>)}
        </ul>
        <div class="venture__links">
          <a class="btn btn--solid btn--small" href={arena.live} rel="noopener"><Icon name="play" />Watch a match</a>
          <a class="btn btn--small" href={arena.repo} rel="noopener"><Icon name="github" />Code</a>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .traction {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .traction div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--hi);
  }

  .traction dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    font-stretch: 76%;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .traction dt {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .traction__note {
    margin-top: 0.7rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .ventures {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding-top: clamp(2rem, 5vw, 3.5rem);
    border-top: 1.5px solid var(--ink);
    scroll-margin-top: 4.5rem;
    align-items: start;
  }

  .venture,
  .venture--media > div {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .venture {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1.1rem, 2vw, 1.6rem);
  }

  .venture--media {
    padding: 0;
    overflow: hidden;
  }

  .venture--media > div {
    padding: clamp(1.1rem, 2vw, 1.6rem);
  }

  .venture--media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 20% 35%;
    border-bottom: 1px solid var(--rule);
  }

  .venture header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
  }

  .venture h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    font-stretch: 80%;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .venture__line {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }

  .venture__body {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .venture__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }

  @media (min-width: 60rem) {
    .ventures {
      grid-template-columns: 1fr 1fr;
    }
  }

  .video {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  .video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--ink);
  }

  .video figcaption {
    max-width: 20rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--ink-soft);
    text-align: center;
  }

  .outputs {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 20rem);
  }

  .stickers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
  }

  .stickers img {
    width: 100%;
  }

  .pages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .pages img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
</style>
