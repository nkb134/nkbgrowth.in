---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import desiShot from '../assets/shots/desi-taboo.png';
import arenaShot from '../assets/shots/arena.jpg';
import momosShot from '../assets/shots/momos.png';
import desiIcon from '../assets/icons/desi-taboo.svg';
import momosIcon from '../assets/icons/momos.svg';
import { builds } from '../data/builds';

const shots: Record<string, ImageMetadata> = { 'desi-taboo': desiShot, arena: arenaShot, momos: momosShot };
const icons: Record<string, ImageMetadata> = { 'desi-taboo': desiIcon, momos: momosIcon };
---

<section class="section builds" id="builds" aria-labelledby="builds-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="label">Side builds</p>
      <h2 id="builds-title">Things I shipped <span class="hi">for the fun of it</span></h2>
      <p>Small, finished and live. Two of them run right here on the page.</p>
    </div>

    <ul class="builds__grid">
      {
        builds.map((b) => (
          <li class="build" data-reveal>
            <div class:list={['build__shot', b.embed && 'build__shot--tall']}>
              <Image src={shots[b.id]} alt={`${b.name} screenshot`} width={640} loading="lazy" />
            </div>
            <div class="build__body">
              <header>
                {icons[b.id] ? (
                  <img src={icons[b.id].src} alt="" width="40" height="40" class="build__icon" />
                ) : (
                  <span class="build__icon build__icon--glyph">
                    <Icon name="swords" />
                  </span>
                )}
                <h3>{b.name}</h3>
              </header>
              <p class="build__line">{b.line}</p>
              <p class="build__detail">{b.detail}</p>
              <ul class="chips">
                {b.stack.map((s) => <li>{s}</li>)}
              </ul>
              <div class="build__links">
                {b.embed ? (
                  <button class="btn btn--solid btn--small" type="button" data-demo={b.live} data-demo-name={b.name}>
                    <Icon name="play" />
                    Play it here
                  </button>
                ) : (
                  <a class="btn btn--solid btn--small" href={b.live} rel="noopener">
                    <Icon name="play" />
                    Watch a match
                  </a>
                )}
                {b.embed && (
                  <a class="btn btn--small" href={b.live} rel="noopener">
                    <Icon name="arrow-up-right" />
                    Open site
                  </a>
                )}
                <a class="btn btn--small" href={b.repo} rel="noopener">
                  <Icon name="github" />
                  Code
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="demo" data-demo-dialog aria-labelledby="demo-title">
    <header>
      <h3 id="demo-title" data-demo-title>Demo</h3>
      <form method="dialog">
        <button class="btn btn--small" type="submit">Close</button>
      </form>
    </header>
    <iframe title="Live demo" data-demo-frame allow="autoplay; fullscreen"></iframe>
  </dialog>
</section>

<style>
  .builds {
    background: var(--paper-deep);
    border-block: 1px solid var(--rule);
  }

  .builds__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .build {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .build__shot {
    aspect-ratio: 16 / 10;
    background: var(--ink);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  .build__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .build__body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .build__body header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .build__icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 22%;
  }

  .build__icon--glyph {
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--hi);
    font-size: 1.2rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 80%;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .build__line {
    font-weight: 600;
    line-height: 1.3;
  }

  .build__detail {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .build__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.3rem;
  }

  .demo {
    width: min(100vw - 1.5rem, 25rem);
    height: min(100dvh - 1.5rem, 52rem);
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 1rem;
    background: var(--card);
    color: var(--ink);
    overflow: hidden;
  }

  .demo[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .demo::backdrop {
    background: rgb(14 26 58 / 0.7);
  }

  .demo header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--rule);
  }

  .demo h3 {
    font-size: 1.2rem;
  }

  .demo iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
