---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Trust from './Trust.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../data/site';
import { summary } from '../data/work';
---

<section class="hero wrap" id="top">
  <div class="hero__copy">
    <p class="label">{site.name} · {site.role}</p>
    <h1>
      I <span class="hi">build</span> the things that make consumer products <span class="hi">grow</span>.
    </h1>
    <p class="hero__lede">
      For 12+ years I’ve worked on consumer fintech, crypto and now consumer AI, in India and Southeast Asia.
      At CoinDCX I rebuilt the referral product, started the creator channel and ran the futures business as
      its P&amp;L owner. Today I build my own AI products on WhatsApp and do the growth work on them myself.
    </p>
    <div class="hero__actions">
      <a class="btn btn--solid" href={`mailto:${site.email}`}><Icon name="mail" />Email me</a>
      <a class="btn" href={site.linkedin} rel="noopener"><Icon name="linkedin" />LinkedIn</a>
      <a class="btn" href={site.github} rel="noopener"><Icon name="github" />GitHub</a>
    </div>
  </div>

  <figure class="hero__portrait">
    <Image
      src={portrait}
      alt="Portrait of Nissar Behera"
      widths={[320, 480, 720]}
      sizes="(min-width: 60rem) 22rem, 12rem"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption class="label">
      <Icon name="map-pin" />
      {site.location} · {site.relocation}
    </figcaption>
  </figure>
</section>

<Trust />

<section class="both wrap" aria-label="Summary">
  {
    [summary.grow, summary.build].map((side, i) => (
      <div class:list={['both__side', i === 1 && 'both__side--build']} data-reveal>
        <h2 class="label">{side.title}</h2>
        <dl>
          {side.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
        <a href={side.href}>
          {side.link}
          <Icon name="arrow-down" />
        </a>
      </div>
    ))
  }
</section>

<style>
  .hero {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(1.75rem, 4vw, 3rem);
    align-items: end;
  }

  .hero__copy {
    display: grid;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  h1 {
    max-width: 17ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1rem + 6.4vw, 6.5rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  /* The hero is visible at once; only the highlighter strokes animate in. */
  @media (prefers-reduced-motion: no-preference) {
    h1 .hi {
      animation: swipe 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s both;
    }

    h1 .hi:last-of-type {
      animation-delay: 0.85s;
    }

    @keyframes swipe {
      from {
        background-size: 0% 64%;
      }
      to {
        background-size: 100% 64%;
      }
    }
  }

  .hero__lede {
    max-width: 58ch;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero__portrait {
    width: 12rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: var(--card);
    overflow: hidden;
  }

  .hero__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .hero__portrait figcaption {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.6rem 0.7rem;
    border-top: 1.5px solid var(--ink);
    line-height: 1.3;
  }

  /* Two halves of one band: company work on highlighter, own products on ink. */
  .both {
    display: grid;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .both__side {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--hi);
  }

  .both__side--build {
    background: var(--ink);
    color: var(--paper);
  }

  .both__side .label {
    color: inherit;
  }

  .both dl {
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    margin: 0;
  }

  .both dl div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.3rem;
  }

  .both dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    font-stretch: 76%;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .both dt {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .both a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    justify-self: start;
    font-weight: 600;
  }

  .both__side--build :global(:focus-visible) {
    outline-color: var(--hi);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }

    .hero__portrait {
      width: 100%;
    }

    .both {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
