---
import { logos, type LogoName } from '../data/logos';

// Each logo keeps its own brand colours; `scale` evens out their optical size.
interface Props {
  name: LogoName;
  /** Height in rem of a scale-1 logo. */
  size?: number;
}

const { name, size = 1.5 } = Astro.props;
const logo = logos[name];
---

<img
  class="logo"
  src={logo.url}
  alt={logo.label}
  loading="lazy"
  decoding="async"
  style={`height:${(size * logo.scale).toFixed(2)}rem;aspect-ratio:${logo.ratio}`}
/>

<style>
  .logo {
    display: block;
    flex: none;
    width: auto;
    max-width: none;
  }
</style>
