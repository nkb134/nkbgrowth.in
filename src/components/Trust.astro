---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { employers, logos } from '../data/logos';
import { credentials } from '../data/site';
---

<section class="trust wrap" aria-labelledby="trust-title">
  <h2 class="label" id="trust-title">Where I’ve worked</h2>
  <ul class="trust__logos">
    {
      employers.map((name) => (
        <li>
          <Logo name={name} />
          {'named' in logos[name] && <span aria-hidden="true">{logos[name].label}</span>}
        </li>
      ))
    }
  </ul>

  <ul class="trust__marks">
    {
      credentials.map((c) => (
        <li>
          <Icon name={c.icon} />
          <p>
            <strong>{c.title}</strong>
            <span>{c.detail}</span>
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust {
    display: grid;
    gap: 1.25rem;
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .trust__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.25rem;
    border-block: 1px solid var(--rule);
    color: var(--ink);
  }

  /* A mark with no wordmark of its own gets its name set beside it. */
  .trust__logos li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .trust__logos span {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 800;
    font-stretch: 80%;
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .trust__marks {
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .trust__marks li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }

  .trust__marks :global(.icon) {
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.15rem;
  }

  .trust__marks p {
    display: grid;
    line-height: 1.3;
  }

  .trust__marks span {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>
