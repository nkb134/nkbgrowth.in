---
interface Props {
  label: string;
  from: number;
  to: number;
  fromText: string;
  toText: string;
  note: string;
  where: string;
}

const { label, from, to, fromText, toText, note, where } = Astro.props;

// Zero-based axis inside a 200x64 box: baseline at y=58, tallest value at y=8.
const X1 = 10;
const X2 = 190;
const BASE = 58;
const SPAN = 50;
const y = (v: number) => +(BASE - (v / Math.max(from, to)) * SPAN).toFixed(2);
const y1 = y(from);
const y2 = y(to);
---

<article class="slope" data-reveal>
  <header class="slope__head">
    <h3>{label}</h3>
    <span class="label">{where}</span>
  </header>
  <p class="slope__delta">
    <span class="slope__from">{fromText}</span>
    <span class="slope__arrow" aria-hidden="true">→</span>
    <span class="visually-hidden">to</span>
    <span class="hi">{toText}</span>
  </p>
  <svg viewBox="0 0 200 64" role="img" aria-label={`${label}: ${fromText} to ${toText}`}>
    <polygon class="slope__area" points={`${X1},${y1} ${X2},${y2} ${X2},${BASE} ${X1},${BASE}`}></polygon>
    <line class="slope__base" x1={X1} y1={BASE} x2={X2} y2={BASE}></line>
    <line class="slope__line" x1={X1} y1={y1} x2={X2} y2={y2} pathLength="1"></line>
    <circle class="slope__dot" cx={X1} cy={y1} r="3.5"></circle>
    <circle class="slope__dot slope__dot--end" cx={X2} cy={y2} r="3.5"></circle>
  </svg>
  <p class="slope__note">{note}</p>
</article>

<style>
  .slope {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1rem, 2vw, 1.4rem);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .slope__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .slope__head h3 {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .slope__delta {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3rem);
    font-weight: 800;
    font-stretch: 76%;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .slope__from,
  .slope__arrow {
    color: var(--ink-soft);
    font-weight: 500;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .slope__area {
    fill: var(--hi);
  }

  .slope__base {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .slope__line {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  .slope__dot {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  .slope__dot--end {
    fill: var(--ink);
  }

  .slope__note {
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .slope__line {
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 0.9s cubic-bezier(0.3, 0.7, 0.2, 1) 0.15s;
    }

    :global(.js) .slope__area,
    :global(.js) .slope__dot--end {
      opacity: 0;
      transition: opacity 0.5s ease 0.8s;
    }

    :global(.js) .slope.is-in .slope__line {
      stroke-dashoffset: 0;
    }

    :global(.js) .slope.is-in .slope__area,
    :global(.js) .slope.is-in .slope__dot--end {
      opacity: 1;
    }
  }
</style>
