---
import Logo from './Logo.astro';
import { experience } from '../data/experience';
import { education, skills } from '../data/site';
---

<section class="section history" id="history" aria-labelledby="history-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="label">Work history</p>
      <h2 id="history-title">Everywhere I’ve worked, <span class="hi">newest first</span></h2>
    </div>

    <ol class="roles">
      {
        experience.map((role) => (
          <li class="role" data-reveal>
            <p class="role__dates label">
              {role.dates}
              <span>{role.place}</span>
            </p>
            <div class="role__body">
              <h3>
                {role.title}, <span>{role.company}</span>
              </h3>
              {role.points.map((p) => (
                <p>{p}</p>
              ))}
              {role.href && (
                <a class="role__more" href={role.href}>
                  Details above
                </a>
              )}
            </div>
            {role.logo && (
              <div class="role__logo">
                <Logo name={role.logo} size={1.15} />
              </div>
            )}
          </li>
        ))
      }
    </ol>

    <div class="extras">
      <div data-reveal>
        <h3 class="label">What I work with</h3>
        <dl class="skills">
          {
            skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>{s.items}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div data-reveal>
        <h3 class="label">Education</h3>
        <ul class="education">
          {
            education.map((e) => (
              <li>
                <strong>{e.degree}</strong>
                <span>{e.school}</span>
                <span class="label">{e.years}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .history {
    background: var(--paper-deep);
    border-top: 1px solid var(--rule);
  }

  .role {
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: clamp(1rem, 2.5vw, 1.5rem);
    border-top: 1px solid var(--rule);
  }

  .role:first-child {
    border-top: 1.5px solid var(--ink);
  }

  .role__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--ink);
  }

  .role__dates span {
    color: var(--ink-soft);
  }

  .role__body {
    display: grid;
    gap: 0.4rem;
    max-width: 70ch;
  }

  .role h3 {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.15;
  }

  .role h3 span {
    font-weight: 500;
  }

  .role__body p {
    color: var(--ink-soft);
  }

  .role__logo {
    color: var(--ink-soft);
  }

  .role__more {
    justify-self: start;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .extras {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1.5px solid var(--ink);
  }

  .extras h3 {
    margin-bottom: 1rem;
  }

  .skills {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 700;
  }

  .skills dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .education {
    display: grid;
    gap: 1.25rem;
  }

  .education li {
    display: grid;
    gap: 0.15rem;
  }

  .education span:not(.label) {
    color: var(--ink-soft);
  }

  @media (min-width: 52rem) {
    .role {
      grid-template-columns: 13rem minmax(0, 1fr) auto;
    }

    .role__logo {
      grid-column: 3;
      padding-top: 0.3rem;
    }

    .role__dates {
      flex-direction: column;
      padding-top: 0.35rem;
    }

    .extras {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
</style>
