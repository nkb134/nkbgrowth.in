---
import { experience } from '../data/experience';
import { education, skills } from '../data/site';
---

<section class="section wrap" id="experience" aria-labelledby="experience-title">
  <div class="section-head" data-reveal>
    <p class="label">Experience</p>
    <h2 id="experience-title">Engineer, consultant, growth lead, <span class="hi">founder</span></h2>
  </div>

  <ol class="roles">
    {
      experience.map((role) => (
        <li class="role" data-reveal>
          <p class="role__dates label">
            {role.dates}
            <span>{role.place}</span>
          </p>
          <div class="role__body">
            <h3>
              {role.title}, <span>{role.company}</span>
            </h3>
            {role.about && <p class="role__about">{role.about}</p>}
            <ul>
              {role.points.map((p) => (
                <li>
                  {p.lead && <strong>{p.lead}. </strong>}
                  {p.text}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="extras">
    <div data-reveal>
      <h3 class="label">What I work with</h3>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div data-reveal>
      <h3 class="label">Education</h3>
      <ul class="education">
        {
          education.map((e) => (
            <li>
              <strong>{e.degree}</strong>
              <span>{e.school}</span>
              <span class="label">{e.years}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .role {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--rule);
  }

  .role:first-child {
    border-top: 1.5px solid var(--ink);
  }

  .role__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--ink);
  }

  .role__dates span {
    color: var(--ink-soft);
  }

  .role__body {
    display: grid;
    gap: 0.6rem;
  }

  .role h3 {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.15;
  }

  .role h3 span {
    font-weight: 500;
  }

  .role__about {
    color: var(--ink-soft);
    font-style: italic;
  }

  .role__body ul {
    display: grid;
    gap: 0.5rem;
    max-width: 70ch;
    color: var(--ink-soft);
  }

  .role__body li {
    padding-left: 1.1rem;
    position: relative;
  }

  .role__body li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1.5px;
    background: var(--ink);
  }

  .role__body strong {
    color: var(--ink);
  }

  .extras {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1.5px solid var(--ink);
  }

  .extras h3 {
    margin-bottom: 1rem;
  }

  .skills {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 700;
  }

  .skills dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .education {
    display: grid;
    gap: 1.25rem;
  }

  .education li {
    display: grid;
    gap: 0.15rem;
  }

  .education span:not(.label) {
    color: var(--ink-soft);
  }

  @media (min-width: 52rem) {
    .role {
      grid-template-columns: 13rem minmax(0, 1fr);
    }

    .role__dates {
      flex-direction: column;
      padding-top: 0.35rem;
    }

    .extras {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
</style>
